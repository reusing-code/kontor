#!/bin/sh
# Usage: ci/github-release <tag>
# Creates the GitHub release for a v* tag with the title, text and pre-release
# flag of the Forgejo release (tag name and no text if there is none) and the
# notes from ci/release-notes. Skips a draft and a release GitHub already has.
# Waits up to 10 minutes for the push mirror to bring the tag to GitHub.
# Env: GH_TOKEN (fine-grained PAT, contents: write on GH_REPO), GH_REPO
# (owner/name on GitHub), FORGEJO_API (repo API URL,
# https://<host>/api/v1/repos/<owner>/<repo>), FORGEJO_TOKEN (optional),
# DRY_RUN (non-empty: print the request instead of creating the release).
# Needs curl, jq and the tags with their history.
set -eu

tag=$1
: "${GH_TOKEN:?}" "${GH_REPO:?}" "${FORGEJO_API:?}"
api=https://api.github.com/repos/$GH_REPO
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

# github <method> <url> [data-file]: prints the HTTP status, body in $tmp/resp
github() {
  curl -sS -o "$tmp/resp" -w '%{http_code}' -X "$1" \
    -H "Authorization: Bearer $GH_TOKEN" \
    -H 'Accept: application/vnd.github+json' \
    -H 'X-GitHub-Api-Version: 2022-11-28' \
    ${3:+--data-binary "@$3"} "$2"
}

fail() {
  echo "ci/github-release: $1" >&2
  [ -s "$tmp/resp" ] && cat "$tmp/resp" >&2
  exit 1
}

case $(github GET "$api/releases/tags/$tag") in
  200) echo "GitHub release $tag exists, skipping"; exit 0 ;;
  404) ;;
  *) fail "looking up GitHub release $tag failed" ;;
esac

status=$(curl -sS -o "$tmp/forgejo" -w '%{http_code}' \
  ${FORGEJO_TOKEN:+-H "Authorization: token $FORGEJO_TOKEN"} \
  "$FORGEJO_API/releases/tags/$tag")
case $status in
  200)
    if [ "$(jq -r .draft "$tmp/forgejo")" = true ]; then
      echo "Forgejo release $tag is a draft, skipping"
      exit 0
    fi
    name=$(jq -r '.name // ""' "$tmp/forgejo")
    prerelease=$(jq -r .prerelease "$tmp/forgejo")
    jq -r '.body // ""' "$tmp/forgejo" > "$tmp/body"
    ;;
  404) name=; prerelease=false; : > "$tmp/body" ;;
  *) cat "$tmp/forgejo" >&2; fail "looking up Forgejo release $tag failed ($status)" ;;
esac
[ -n "$name" ] || name=$tag
printf '%s' "${tag#v}" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+$' || prerelease=true

want=$(git rev-parse "refs/tags/$tag")
tries=20
while :; do
  case $(github GET "$api/git/ref/tags/$tag") in
    200)
      got=$(jq -r .object.sha "$tmp/resp")
      [ "$got" = "$want" ] && break
      fail "tag $tag is $got on GitHub, expected $want"
      ;;
    404) ;;
    *) fail "looking up tag $tag on GitHub failed" ;;
  esac
  tries=$((tries - 1))
  [ "$tries" -gt 0 ] || fail "tag $tag did not reach GitHub, check the push mirror"
  echo "tag $tag not on GitHub yet, waiting for the push mirror"
  sleep 30
done

"$(dirname "$0")/release-notes" "$tag" "$tmp/body" > "$tmp/notes"
jq -n --arg tag "$tag" --arg name "$name" --rawfile body "$tmp/notes" \
  --argjson prerelease "$prerelease" \
  '{tag_name: $tag, name: $name, body: $body, prerelease: $prerelease}' > "$tmp/payload"

if [ -n "${DRY_RUN:-}" ]; then
  jq . "$tmp/payload"
  exit 0
fi
[ "$(github POST "$api/releases" "$tmp/payload")" = 201 ] || fail "creating GitHub release $tag failed"
echo "created $(jq -r .html_url "$tmp/resp")"
